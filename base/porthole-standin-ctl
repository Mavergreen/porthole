#!/bin/sh
# porthole-standin-ctl -- place, start, check and stop the per-application stand-ins
# (porthole-standin) in a Porthole container. Driven from the Mac by porthole-standin-bridge, one
# `docker exec` per call, every path an argv element of its own (Mac application paths have spaces).
#
#   place APP              (root)     hard-link the stand-in at APP's container path; print it
#   alive SID              (uid 1000) exit 0 iff SID's stand-in is listening
#   start SID TARGET PROG… (uid 1000) start TARGET as a child of xpra, serving PROG per connection
#   stop SID                          stop SID's stand-in and remove its files
#   list                              print each live SID, one per line
#
# A .app under /Applications/ or /Users/<u>/Applications/ keeps its real path, so the app names it
# the way the Mac does; anything else goes under /Mac. Nothing is placed on a host mount.
set -eu
D=/run/user/1000/porthole-standin
XPRA_SOCKET=${XPRA_SOCKET:-/run/user/1000/porthole-xpra.sock}
STANDIN=/usr/local/bin/porthole-standin
NL='
'
me=porthole-standin-ctl
refuse() { echo "$me: $*" >&2; exit 2; }

check_sid() {
  case $1 in
    '' | *[!A-Za-z0-9._-]* | .*) refuse "not a stand-in id: '$1'" ;;
  esac
}

alive() {
  [ -S "$D/$1.sock" ] && [ -f "$D/$1.pid" ] || return 1
  pid=$(cat "$D/$1.pid" 2>/dev/null) || return 1
  case $pid in '' | *[!0-9]*) return 1 ;; esac
  kill -0 "$pid" 2>/dev/null
}

device() { stat -c %d "$1"; }

place() {
  app=$1
  case $app in /*) ;; *) refuse "not an absolute path: '$app'" ;; esac
  case $app in *"$NL"*) refuse "a path with a newline" ;; esac
  case "$app/" in */./* | */../*) refuse "a path with a . or .. component: '$app'" ;; esac
  case $app in
    /Applications/*.app | /Users/*/Applications/*.app) target=$app ;;
    *) target=/Mac$app ;;
  esac
  case $target in */) refuse "a path ending in /: '$app'" ;; esac
  near=$(dirname "$target")
  while [ ! -e "$near" ]; do near=$(dirname "$near"); done
  [ "$(device "$near")" = "$(device /)" ] \
    || refuse "'$target' would be on a host mount ($near)"
  mkdir -p "$(dirname "$target")"
  if [ ! "$target" -ef "$STANDIN" ]; then
    ln -f "$STANDIN" "$target"
  fi
  printf '%s\n' "$target"
}

start() {
  sid=$1 target=$2; shift 2
  [ $# -ge 1 ] || refuse "start: no PROG"
  alive "$sid" && exit 0
  rm -f "$D/$sid.sock" "$D/$sid.pid"
  mkdir -p "$D"; chmod 0700 "$D"
  xpra control "socket://$XPRA_SOCKET" start "$target" "$D/$sid.sock" "$@" >/dev/null
  n=0
  until alive "$sid"; do
    n=$((n + 1))
    [ "$n" -le 50 ] || { echo "$me: stand-in did not come up: $sid ($target)" >&2; exit 1; }
    sleep 0.1
  done
}

stop() {
  sid=$1
  pid=$(cat "$D/$sid.pid" 2>/dev/null) || pid=
  case $pid in '' | *[!0-9]*) ;; *) kill -TERM "$pid" 2>/dev/null || : ;; esac
  rm -f "$D/$sid.sock" "$D/$sid.pid"
}

list() {
  for f in "$D"/*.sock; do
    [ -S "$f" ] || continue
    sid=${f##*/}; sid=${sid%.sock}
    if alive "$sid"; then printf '%s\n' "$sid"; fi
  done
}

[ $# -ge 1 ] || refuse "usage: $me place APP | alive SID | start SID TARGET PROG... | stop SID | list"
cmd=$1; shift
case $cmd in
  place) [ $# -eq 1 ] || refuse "usage: $me place APP"; place "$1" ;;
  alive) [ $# -eq 1 ] || refuse "usage: $me alive SID"; check_sid "$1"; alive "$1" ;;
  start) [ $# -ge 3 ] || refuse "usage: $me start SID TARGET PROG..."; check_sid "$1"; start "$@" ;;
  stop) [ $# -eq 1 ] || refuse "usage: $me stop SID"; check_sid "$1"; stop "$1" ;;
  list) [ $# -eq 0 ] || refuse "usage: $me list"; list ;;
  *) refuse "unknown command: $cmd" ;;
esac
