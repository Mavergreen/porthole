#!/bin/sh
# platform: host-agnostic -- runs inside the Linux container (Debian), never on the Mac
# porthole-standin-ctl -- start, check and stop the per-application stand-ins
# (porthole-standin) in a Porthole container. Driven from the Mac by porthole-standin-bridge, one
# `docker exec` per call, every path an argv element of its own (Mac application paths have spaces).
#
#   alive SID              (uid 1000) exit 0 iff SID's stand-in is listening
#   start SID APP TO       (uid 1000) start the stand-in at the Mac path APP (porthole-standin-at,
#                                     in its own namespace) as a child of xpra, relaying each
#                                     connection to the Unix socket TO itself (so TO's server sees
#                                     APP connect); exit 3, saying why, if this container can't
#   stop SID                          stop SID's stand-in and remove its files
#   list                              print each live SID, one per line
set -eu
D=/run/user/1000/porthole-standin
XPRA_SOCKET=${XPRA_SOCKET:-/run/user/1000/porthole-xpra.sock}
me=porthole-standin-ctl
refuse() { echo "$me: $*" >&2; exit 2; }

check_sid() {
  case $1 in
    '' | *[!A-Za-z0-9._-]* | .*) refuse "not a stand-in id: '$1'" ;;
  esac
}

# Alive: the socket is there and the pid file names a running stand-in serving it. A pid alone is
# not enough: a stand-in killed outright leaves its files, and its pid may be reused.
alive() {
  [ -S "$D/$1.sock" ] && [ -f "$D/$1.pid" ] || return 1
  pid=$(cat "$D/$1.pid" 2>/dev/null) || return 1
  case $pid in '' | *[!0-9]*) return 1 ;; esac
  kill -0 "$pid" 2>/dev/null || return 1
  arg1=$(tr '\000' '\n' < "/proc/$pid/cmdline" 2>/dev/null | sed -n 2p)
  [ "$arg1" = "$D/$1.sock" ]
}

start() {
  sid=$1 app=$2 to=$3
  alive "$sid" && exit 0
  # Said once here, plainly, rather than as a stand-in that never comes up.
  why=$(porthole-standin-at --check 2>&1) || { echo "$why" >&2; exit 3; }
  rm -f "$D/$sid.sock" "$D/$sid.pid"
  mkdir -p "$D"; chmod 0700 "$D"
  xpra control "socket://$XPRA_SOCKET" start porthole-standin-at "$app" "$D/$sid.sock" "$to" >&2
  n=0
  until alive "$sid"; do
    n=$((n + 1))
    [ "$n" -le 50 ] || { echo "$me: stand-in did not come up: $sid ($app)" >&2; exit 1; }
    sleep 0.1
  done
}

stop() {
  sid=$1
  pid=$(cat "$D/$sid.pid" 2>/dev/null) || pid=
  case $pid in '' | *[!0-9]*) ;; *) kill -TERM "$pid" 2>/dev/null || : ;; esac
  rm -f "$D/$sid.sock" "$D/$sid.pid"
}

list() {
  for f in "$D"/*.sock; do
    [ -S "$f" ] || continue
    sid=${f##*/}; sid=${sid%.sock}
    if alive "$sid"; then printf '%s\n' "$sid"; fi
  done
}

[ $# -ge 1 ] || refuse "usage: $me alive SID | start SID APP TO | stop SID | list"
cmd=$1; shift
case $cmd in
  alive) [ $# -eq 1 ] || refuse "usage: $me alive SID"; check_sid "$1"; alive "$1" ;;
  start) [ $# -eq 3 ] || refuse "usage: $me start SID APP TO"; check_sid "$1"; start "$@" ;;
  stop) [ $# -eq 1 ] || refuse "usage: $me stop SID"; check_sid "$1"; stop "$1" ;;
  list) [ $# -eq 0 ] || refuse "usage: $me list"; list ;;
  *) refuse "unknown command: $cmd" ;;
esac
