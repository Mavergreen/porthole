#!/bin/sh
# platform: macOS-only -- notifies via osascript and materializes app bundles under /Applications
# porthole -- the Porthole engine CLI (runs from inside the installed Porthole.app or a
# repo checkout). Subcommands:
#   materialize <conf-path> [--apps-dir DIR]
#       Render a preset conf into a standalone "Linux <App>.app" that wraps the SHARED
#       installed Porthole viewer engine (build-time viewer generation's on-Mac,
#       install-time counterpart). materialize also drops a resolved <slug>.container spec
#       into the .app: the single source of truth `up`/`exec` read.
#   up [--rebuild] <container-spec>
#       Bring a viewer's container up (build the image when it is missing or was built from another
#       recipe, recreate a container left on a superseded image, create volumes, run it
#       with the spec's caps/volumes/mounts, else start it). Headless -- no viewer. This is
#       the ONE creator of the container; the launcher and any companion CLI route through
#       it, so the GUI and CLI can never land on different containers.
#   exec <container-spec> [docker-exec flags...] -- <command...>
#       Ensure the container is up, then run <command> inside it (docker exec). The generic
#       primitive a companion CLI (e.g. bin/op) is built on. Flags before `--` pass straight
#       through to docker exec (-i, -it, -u U, -e K=V, ...).
set -eu

ENGINE=$(cd "$(dirname "${PORTHOLE_SELF:-$0}")/.." && pwd)   # engine root: bin/, templates/, viewer/cmake/
. "$ENGINE/bin/porthole-say.sh"

usage() {
  cat >&2 <<'EOF'
usage:
  porthole materialize <conf-path> [--apps-dir DIR]
  porthole up [--rebuild] <container-spec>
  porthole exec <container-spec> [docker-exec flags...] -- <command...>
  porthole forget <slug> [--keep-data | --delete-data]
EOF
  exit 2
}

# --- up: the SINGLE container creator (headless) -----------------------------
RECIPE_LABEL=dev.mavergreen.porthole.recipe
SLUG_LABEL=dev.mavergreen.porthole.slug   # on everything up creates; housekeeping finds its objects by it

# Every file in the build context, names and contents, in a stable order.
recipe_fingerprint() {
  (cd "$1" && find . -type f | LC_ALL=C sort | while IFS= read -r _f; do
    printf '%s\n' "$_f"; cat "$_f"
  done) | shasum -a 256 | cut -d' ' -f1
}

# Remove Porthole's own disposables: stopped containers that aren't an app's current one (<slug>-gui),
# and dangling images. Found by label only; volumes are never touched here.
porthole_cleanup() {
  docker ps -a --filter "label=$SLUG_LABEL" --filter status=exited --filter status=created \
      --format "{{.Names}} {{.Label \"$SLUG_LABEL\"}}" 2>/dev/null |
    while read -r _cn _cs; do
      [ "$_cn" = "$_cs-gui" ] || docker rm "$_cn" >/dev/null 2>&1 || true
    done
  docker image prune -f --filter "label=$SLUG_LABEL" >/dev/null 2>&1 || true
  return 0
}

# Free space, in KB. Needed: pulling -> the image's compressed layers x3 to unpack, plus 1 GiB for the
# app's own layer; building on a present base -> 1.5 GiB. Either may fail (no registry, no local image
# to run df in); a failed estimate never blocks a launch.
space_needed_kb() {  # FROM
  if docker image inspect "$1" >/dev/null 2>&1; then echo $((1536 * 1024)); return 0; fi
  _z=$(docker manifest inspect "$1" 2>/dev/null | tr -d '\n' | sed 's/.*"layers"//' |
    grep -o '"size"[[:space:]]*:[[:space:]]*[0-9]*' | sed 's/[^0-9]//g' |
    awk '{ t += $1 } END { if (t) printf "%.0f", t }')
  [ -n "$_z" ] || return 1
  echo $((_z * 3 / 1024 + 1024 * 1024))
}
space_free_kb() {
  _img=$(docker images -q 2>/dev/null | head -1)
  [ -n "$_img" ] || return 1
  docker run --rm --entrypoint df "$_img" -Pk / 2>/dev/null | awk 'NR == 2 { print $4 }'
}
space_gb() { awk -v k="$1" 'BEGIN { printf "%.1f", k / 1024 / 1024 }'; }

cmd_up() {
  _rebuild=0
  [ "${1:-}" = --rebuild ] && { _rebuild=1; shift; }
  _spec="${1:-}"; [ -n "$_spec" ] || usage
  [ -f "$_spec" ] || { echo "porthole up: no such container spec: $_spec" >&2; exit 1; }
  _specdir=$(cd "$(dirname "$_spec")" && pwd)
  NAME= SLUG= CONTAINER= IMAGE= HOSTNAME= BUILD_CONTEXT= DATADIR= VOLUME= CAPS= EXTRA_VOLUMES= HOST_MOUNTS=
  # shellcheck disable=SC1090
  . "$_spec"
  : "${SLUG:=$(basename "$_spec" .container)}"
  [ -n "$CONTAINER" ] && [ -n "$IMAGE" ] \
    || { echo "porthole up: spec missing CONTAINER/IMAGE: $_spec" >&2; exit 1; }
  _ctx="$_specdir/$BUILD_CONTEXT"
  # Progress for the app's launch window (plain text on stderr outside it). Build steps come from
  # docker's classic "Step N/M" lines; the build log itself goes to stderr.
  _build_with_progress() {
    docker build "$@" 2>&1 | while IFS= read -r _bl; do
      case "$_bl" in
        "Step "*)
          _nm=${_bl#Step }; _nm=${_nm%% *}
          say_step "Building ${NAME:-the app} ($_nm)"
          say_progress "$(echo "$_nm" | awk -F/ '{ printf "%s", $1 / $2 }')" ;;
      esac
      printf '%s\n' "$_bl" >&2
    done
  }
  # Pull a missing base on its own first, so its download shows as layer-by-layer progress.
  _pull_base() {
    _from=$(sed -n 's/^FROM[[:space:]][[:space:]]*\([^[:space:]]*\).*/\1/p' "$_ctx/Dockerfile" | head -1)
    [ -n "$_from" ] || return 0
    docker image inspect "$_from" >/dev/null 2>&1 && return 0
    say_step "Downloading the Linux runtime"
    docker pull "$_from" 2>&1 | awk '
      / Pulling fs layer$/ || / Already exists$/ { t++ }
      / Pull complete$/ || / Already exists$/     { d++; if (t) { printf "%s\n", d / t; fflush() } }
      { print > "/dev/stderr" }' | while read -r _f; do say_progress "$_f"; done
  }

  # The image is labelled with a fingerprint of the recipe it was built from (the build context,
  # FROM line included, so a new base counts). An image under the same name that lacks the label
  # or carries another one was built from something else -- an older recipe or base -- and is
  # rebuilt, never reused.
  _fp=$(recipe_fingerprint "$_ctx")
  _old_id=$(docker image inspect --format '{{.Id}}' "$IMAGE" 2>/dev/null || true)
  _have=$(docker image inspect --format "{{ index .Config.Labels \"$RECIPE_LABEL\" }}" "$IMAGE" 2>/dev/null || true)
  if [ "$_rebuild" = 1 ] || [ "$_have" != "$_fp" ]; then
    echo "porthole up: building $IMAGE (can take a few minutes)..." >&2
    _from=$(sed -n 's/^FROM[[:space:]][[:space:]]*\([^[:space:]]*\).*/\1/p' "$_ctx/Dockerfile" | head -1)
    if _need=$(space_needed_kb "$_from") && _free=$(space_free_kb) && [ -n "$_free" ] \
       && [ "$_free" -lt "$_need" ]; then
      porthole_cleanup
      _free=$(space_free_kb) || _free=
      if [ -n "$_free" ] && [ "$_free" -lt "$_need" ]; then
        say_error "${NAME:-This app} needs about $(space_gb "$_need") GB to update; the Docker VM has $(space_gb "$_free") GB free after cleanup." \
          "Free space in Docker, or enlarge the VM with Container Tools."
        exit 3
      fi
    fi
    _pull_base
    if [ "$_rebuild" = 1 ]; then
      _build_with_progress --no-cache --pull --force-rm --label "$RECIPE_LABEL=$_fp" --label "$SLUG_LABEL=$SLUG" -t "$IMAGE" "$_ctx"
    else
      _build_with_progress --force-rm --label "$RECIPE_LABEL=$_fp" --label "$SLUG_LABEL=$SLUG" -t "$IMAGE" "$_ctx"
    fi
    # The pipe hides docker's exit status (POSIX sh has no PIPESTATUS), so the result is judged by
    # the image: it must carry this recipe's label and, for a --no-cache rebuild, be a new image.
    [ "$(docker image inspect --format "{{ index .Config.Labels \"$RECIPE_LABEL\" }}" "$IMAGE" 2>/dev/null || true)" = "$_fp" ] \
      || { echo "porthole up: image build failed" >&2; exit 1; }
    if [ "$_rebuild" = 1 ] && [ "$(docker image inspect --format '{{.Id}}' "$IMAGE" 2>/dev/null)" = "$_old_id" ]; then
      echo "porthole up: image build failed" >&2; exit 1
    fi
  fi
  _image_id=$(docker image inspect --format '{{.Id}}' "$IMAGE")

  # A container is reused only if it runs the current image; otherwise it is recreated. Its
  # state lives in named volumes, which are kept.
  if docker container inspect "$CONTAINER" >/dev/null 2>&1; then
    if [ "$(docker container inspect -f '{{.Image}}' "$CONTAINER" 2>/dev/null)" = "$_image_id" ]; then
      docker container inspect -f '{{.State.Running}}' "$CONTAINER" 2>/dev/null | grep -q true \
        || docker start "$CONTAINER" >/dev/null || { echo "porthole up: cannot start $CONTAINER" >&2; exit 1; }
      return 0
    fi
    echo "porthole up: recreating $CONTAINER on its new image (volumes kept)" >&2
    docker rm -f "$CONTAINER" >/dev/null || { echo "porthole up: cannot remove $CONTAINER" >&2; exit 1; }
  fi

  docker volume create --label "$SLUG_LABEL=$SLUG" "$VOLUME" >/dev/null || { echo "porthole up: cannot create volume $VOLUME" >&2; exit 1; }
  # Extra named volumes (spec EXTRA_VOLUMES: VOLNAME:CTRPATH) -- e.g. a companion CLI's config dir.
  _vol_args=""
  for _v in $EXTRA_VOLUMES; do
    _vn=${_v%%:*}
    docker volume create --label "$SLUG_LABEL=$SLUG" "$_vn" >/dev/null || { echo "porthole up: cannot create volume $_vn" >&2; exit 1; }
    _vol_args="$_vol_args -v $_v"
  done
  # Capabilities (spec CAPS): each --cap-add'd (e.g. SYS_PTRACE for 1Password's browser peer check).
  _cap_args=""
  for _c in $CAPS; do _cap_args="$_cap_args --cap-add $_c"; done
  # Host-FS mounts: app-inherent (spec HOST_MOUNTS) + ad-hoc (PORTHOLE_EXTRA_MOUNTS env, this launch).
  # Each is MACPATH[:CONTAINERPATH][:ro]; MACPATH may use $HOME; CONTAINERPATH defaults to MACPATH.
  _mount_args=""
  for _m in $HOST_MOUNTS ${PORTHOLE_EXTRA_MOUNTS:-}; do
    case "$_m" in *:ro) _ro=":ro"; _m=${_m%:ro} ;; *) _ro="" ;; esac
    case "$_m" in *:*) _mac=${_m%%:*}; _mc=${_m#*:} ;; *) _mac="$_m"; _mc="$_m" ;; esac
    [ -e "$_mac" ] || { echo "porthole up: skipping mount, no such path: $_mac" >&2; continue; }
    _mount_args="$_mount_args -v $_mac:$_mc$_ro"
  done
  # shellcheck disable=SC2086  # word-splitting is intentional (one arg per token)
  docker run -d --name "$CONTAINER" --label "$SLUG_LABEL=$SLUG" --hostname "${HOSTNAME:-$IMAGE}" \
    --restart unless-stopped --init --shm-size 512m \
    --security-opt seccomp=unconfined \
    $_cap_args \
    -v "$VOLUME:$DATADIR" $_mount_args $_vol_args \
    "$IMAGE" >/dev/null || { echo "porthole up: cannot create container $CONTAINER" >&2; exit 1; }
  [ "$_image_id" != "$_old_id" ] && drop_superseded "$_old_id" "$_ctx"
  porthole_cleanup
  return 0
}

# After a build, free what it superseded: the image it replaced ($1, if any, unless something else
# still runs it) and older tags of the base the recipe builds FROM. Each Porthole release pins a new ~1.4GB base,
# which would otherwise pile up until the Docker VM's disk fills. Untagging a base another app's
# image still sits on only drops the tag; its layers stay until nothing needs them.
drop_superseded() {
  [ -n "$1" ] && { docker rmi "$1" >/dev/null 2>&1 || true; }
  _from=$(sed -n 's/^FROM[[:space:]][[:space:]]*\([^[:space:]]*\).*/\1/p' "$2/Dockerfile" 2>/dev/null | head -1)
  case "${_from##*/}" in *:*) ;; *) return 0 ;; esac
  docker images --format '{{.Repository}}:{{.Tag}}' "${_from%:*}" 2>/dev/null | while IFS= read -r _t; do
    case "$_t" in "$_from"|*:"<none>") ;; *) docker rmi "$_t" >/dev/null 2>&1 || true ;; esac
  done
}

# --- forget: an app is being uninstalled -------------------------------------------------------
# Removes the slug's containers and images. Its data volumes go only on --delete-data, or a "y" at a
# terminal; anything else keeps them. Safe to call when Docker is away: an uninstall must not fail
# over Porthole.
cmd_forget() {
  _slug="${1:-}"; [ -n "$_slug" ] || usage; shift
  _data=ask
  case "${1:-}" in
    --keep-data) _data=keep ;; --delete-data) _data=delete ;; '') ;;
    *) usage ;;
  esac
  if ! docker info >/dev/null 2>&1; then
    echo "porthole forget: Docker isn't reachable; nothing removed for $_slug" >&2; return 0
  fi
  _f="label=$SLUG_LABEL=$_slug"
  docker ps -aq --filter "$_f" 2>/dev/null | while read -r _c; do docker rm -f "$_c" >/dev/null 2>&1 || true; done
  docker images -q --filter "$_f" 2>/dev/null | sort -u | while read -r _i; do docker rmi -f "$_i" >/dev/null 2>&1 || true; done
  _vols=$(docker volume ls -q --filter "$_f" 2>/dev/null)
  [ -n "$_vols" ] || return 0
  if [ "$_data" = ask ]; then
    _data=keep
    if [ -t 0 ]; then
      printf 'Delete the data of %s (%s)? [y/N] ' "$_slug" "$(echo $_vols)" >&2
      read -r _yn || _yn=
      case "$_yn" in [yY]*) _data=delete ;; esac
    fi
  fi
  if [ "$_data" = delete ]; then
    for _v in $_vols; do docker volume rm "$_v" >/dev/null 2>&1 || true; done
    echo "porthole forget: removed $_slug and its data" >&2
  else
    echo "porthole forget: removed $_slug; kept its data ($(echo $_vols))" >&2
  fi
}

# --- exec: run a command in the app's container (ensures up first) -----------
cmd_exec() {
  _spec="${1:-}"; [ -n "$_spec" ] || usage; shift
  [ -f "$_spec" ] || { echo "porthole exec: no such container spec: $_spec" >&2; exit 1; }
  _flags=""
  while [ $# -gt 0 ]; do
    case "$1" in
      --) shift; break ;;
      *) _flags="$_flags $1"; shift ;;
    esac
  done
  [ $# -gt 0 ] || { echo "porthole exec: no command (put -- before it)" >&2; usage; }
  CONTAINER=
  # shellcheck disable=SC1090
  . "$_spec"
  [ -n "$CONTAINER" ] || { echo "porthole exec: spec missing CONTAINER: $_spec" >&2; exit 1; }
  cmd_up "$_spec" 1>&2   # ensure it's up; keep up's chatter off the command's stdout
  # shellcheck disable=SC2086  # $_flags passthrough to docker exec is intentional
  exec docker exec $_flags "$CONTAINER" "$@"
}

# Sourced by tests with PORTHOLE_LIB=1: define the functions, run nothing.
[ -z "${PORTHOLE_LIB:-}" ] || return 0 2>/dev/null
[ $# -gt 0 ] || usage
cmd="$1"; shift
case "$cmd" in
  up)   cmd_up "$@"; exit $? ;;
  exec) cmd_exec "$@" ;;      # cmd_exec's `exec` replaces this process
  forget) cmd_forget "$@"; exit $? ;;
  materialize) ;;             # falls through to the linear body below
  *) usage ;;
esac

CONF_ARG="${1:-}"; [ -n "$CONF_ARG" ] || usage
shift
APPS_DIR="/Applications"
while [ $# -gt 0 ]; do
  case "$1" in
    --apps-dir) APPS_DIR="${2:?--apps-dir needs a dir}"; shift 2 ;;
    *) echo "porthole materialize: unknown arg: $1" >&2; exit 2 ;;
  esac
done

CONF=$(cd "$(dirname "$CONF_ARG")" && pwd)/$(basename "$CONF_ARG")
[ -f "$CONF" ] || { echo "porthole materialize: no such conf: $CONF" >&2; exit 1; }

# Load the conf for NAME + ICON_GLOB, using the same defaults the generator applies.
APP= NAME= ICON_GLOB= ICON_URL=
# shellcheck disable=SC1090
. "$CONF"
# The conf's basename is authoritative for the slug -- a manifest SLUG= is ignored, exactly as
# generate-viewer does. Compute it AFTER sourcing so a conf's SLUG= line cannot clobber it.
SLUG=$(basename "$CONF" .conf)
: "${APP:=$NAME}"
NAME="${NAME:-Linux $APP}"
[ -n "$NAME" ] && [ "$NAME" != "Linux " ] || { echo "porthole materialize: $CONF sets no APP/NAME" >&2; exit 1; }
BUNDLEID="dev.mavergreen.porthole.$SLUG"

# 1) Render the preset (container recipe + launcher) via the generator into a staging dir.
STAGE=$(mktemp -d "${TMPDIR:-/tmp}/porthole-materialize.XXXXXX")
trap 'rm -rf "$STAGE"' EXIT
"$ENGINE/bin/generate-viewer" "$CONF" --out "$STAGE" >/dev/null

# 2) Assemble the standalone .app bundle. Layout keeps the launcher's own assumptions
#    intact: it lives at Contents/Resources/bin/<slug>, so its `_root` resolves to
#    Contents/Resources and its `$_root/<slug>` recipe path is satisfied.
BUNDLE="$APPS_DIR/$NAME.app"
rm -rf "$BUNDLE"
install -d "$BUNDLE/Contents/MacOS" "$BUNDLE/Contents/Resources/bin"
install -m 0755 "$STAGE/bin/$SLUG" "$BUNDLE/Contents/Resources/bin/$SLUG"
cp -R "$STAGE/$SLUG" "$BUNDLE/Contents/Resources/$SLUG"
# The resolved container spec (generate-viewer emitted it beside the launcher). It's the single
# source of truth `porthole up`/`porthole exec` read; its BUILD_CONTEXT=<slug> resolves to the
# recipe dir copied just above. Lives beside it in Resources so relative paths line up.
install -m 0644 "$STAGE/$SLUG.container" "$BUNDLE/Contents/Resources/$SLUG.container"

# A per-app menu manifest (<confdir>/<slug>.menu.json) becomes Resources/menu.json, which the engine
# reads at launch to build the app's native menu bar. Absent -> the default App/Edit/Window only.
_menu="$(dirname "$CONF")/$SLUG.menu.json"
[ -f "$_menu" ] && install -m 0644 "$_menu" "$BUNDLE/Contents/Resources/menu.json"

# This app's OWN copy of the viewer engine binary + the recovery watcher. The copied binary is what
# makes the materialized app a DISTINCT LaunchServices app -- its own icon, name, and instance -- so
# several viewers run at once, each as itself, instead of all reactivating one shared Porthole.app.
# $ENGINE is the installed Porthole.app's Contents/Resources/engine, so the binary is ../../MacOS.
ENGINE_BIN="${PORTHOLE_ENGINE_BIN:-$ENGINE/../../MacOS/Porthole}"
if [ -x "$ENGINE_BIN" ]; then
  install -m 0755 "$ENGINE_BIN" "$BUNDLE/Contents/MacOS/Porthole"
else
  echo "porthole: engine binary not at $ENGINE_BIN -- the app won't launch until re-materialized with Porthole installed" >&2
fi
install -m 0755 "$ENGINE/bin/porthole-recover-watch" "$BUNDLE/Contents/Resources/bin/porthole-recover-watch"
# The icon extractor, so the launcher can swap the penguin for the app's REAL icon (from the user's
# container) on first launch. Resolves in the installed engine ($ENGINE/viewer/cmake) or a dev checkout.
_extract="$ENGINE/viewer/cmake/extract-app-icns.sh"
[ -f "$_extract" ] && install -m 0755 "$_extract" "$BUNDLE/Contents/Resources/bin/extract-app-icns.sh"
install -m 0644 "$ENGINE/bin/porthole-icon-lib.sh" "$BUNDLE/Contents/Resources/bin/porthole-icon-lib.sh"

# CFBundleExecutable stub: a double-click runs the real launcher in Resources/bin.
cat > "$BUNDLE/Contents/MacOS/$SLUG" <<EOF
#!/bin/sh
exec "\$(cd "\$(dirname "\$0")/../Resources/bin" && pwd)/$SLUG" "\$@"
EOF
chmod 755 "$BUNDLE/Contents/MacOS/$SLUG"

# 3) App icon: the largest real icon cached on this Mac, else the penguin. Porthole ships no vendor
#    icon: ICON_URL is fetched from the vendor by this Mac (best-effort, kept across installs in the
#    system cache), and the launcher adds the app's own from its container to the user's cache.
. "$ENGINE/bin/porthole-icon-lib.sh"
SYS_ICONS="${PORTHOLE_ICON_CACHE:-/usr/local/mavergreen/var/porthole/icons}"
if [ -n "$ICON_URL" ] && [ -z "${PORTHOLE_MATERIALIZE_NO_ICON:-}" ]; then
  _fetched=$(mktemp "${TMPDIR:-/tmp}/porthole-icon-url.XXXXXX")
  if ! curl -fsSL --max-time 20 -o "$_fetched" "$ICON_URL" 2>/dev/null; then
    icon_log "$SLUG" "ICON_URL fetch failed ($ICON_URL); kept the cached icon"
  elif ! icon_is_png "$_fetched"; then
    icon_log "$SLUG" "ICON_URL is not a PNG ($ICON_URL); kept the cached icon"
  elif ! icon_png_to_icns "$_fetched" "$SYS_ICONS/$SLUG.icns"; then
    icon_log "$SLUG" "ICON_URL could not be converted ($ICON_URL); kept the cached icon"
  fi
  rm -f "$_fetched"
fi
# The console user's cache (materialize runs as root in a pkg's postinstall). No console user,
# or root at the console, means no user cache to read.
USER_ICONS="${PORTHOLE_USER_ICON_CACHE:-}"
if [ -z "$USER_ICONS" ]; then
  _cu="${PORTHOLE_CONSOLE_USER:-$(stat -f %Su /dev/console 2>/dev/null)}"
  if [ -n "$_cu" ] && [ "$_cu" != root ]; then
    _ch=$(dscl . -read "/Users/$_cu" NFSHomeDirectory 2>/dev/null | awk '{print $2}')
    [ -n "$_ch" ] && USER_ICONS="$_ch/Library/Caches/dev.mavergreen.porthole"
  fi
fi
# Root never reads the user's cache in place: skip a symlink, copy the file to a root-owned temp, and
# measure and install only the copy. A file swapped in between is at worst a non-image, never chosen.
_ucopy=
if [ -n "$USER_ICONS" ] && [ -f "$USER_ICONS/$SLUG.icns" ] && [ ! -L "$USER_ICONS/$SLUG.icns" ]; then
  _ucopy=$(mktemp "${TMPDIR:-/tmp}/porthole-usericon.XXXXXX") \
    && cat "$USER_ICONS/$SLUG.icns" > "$_ucopy" 2>/dev/null || _ucopy=
fi
_icon=$(icon_best "$SYS_ICONS/$SLUG.icns" ${_ucopy:+"$_ucopy"})
ICON_FILE=
PENGUIN="$ENGINE/penguin.icns"; [ -f "$PENGUIN" ] || PENGUIN="$ENGINE/packaging/macos/penguin.icns"
if [ -n "$_icon" ]; then
  install -m 0644 "$_icon" "$BUNDLE/Contents/Resources/AppIcon.icns"
  icon_width "$_icon" > "$BUNDLE/Contents/Resources/AppIcon.width"
  ICON_FILE="AppIcon"
elif [ -f "$PENGUIN" ]; then
  install -m 0644 "$PENGUIN" "$BUNDLE/Contents/Resources/AppIcon.icns"
  echo 0 > "$BUNDLE/Contents/Resources/AppIcon.width"
  ICON_FILE="AppIcon"
fi
[ -n "$_ucopy" ] && rm -f "$_ucopy"

# 4) Info.plist.
cat > "$BUNDLE/Contents/Info.plist" <<EOF
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleExecutable</key><string>$SLUG</string>
	<key>CFBundleName</key><string>$NAME</string>
	<key>CFBundleDisplayName</key><string>$NAME</string>
	<key>CFBundleIdentifier</key><string>$BUNDLEID</string>
	<key>CFBundleIconFile</key><string>$ICON_FILE</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>NSPrincipalClass</key><string>NSApplication</string>
	<key>LSMinimumSystemVersion</key><string>10.9</string>
</dict>
</plist>
EOF

echo "porthole: materialized $BUNDLE"
