#!/bin/sh
# platform: macOS-only -- finds the app in the Mac's Applications folders and reaches the Docker VM
# porthole-cli SLUG NAME [ARG...] -- run the CLI an app declares (its spec's CLI, CLI_<name>), in the
# app's container, the way a native CLI talks to its running app (1Password's `op` shim execs this).
#
# Nothing is started behind the user's back: an app that isn't running is said so, exit 1. Otherwise
# one `docker exec -i` (-t too when stdin and stdout are terminals) as the app's user (CLI_USER_<name>
# overrides), with its HOME and EXTRA_ENV; every argument one argv element; stdout's bytes, stderr and
# the exit status passed through. A Docker connection error is retried once with a fresh endpoint.
set -u
me=porthole-cli
here=$(CDPATH= cd -- "$(dirname -- "$0")" && pwd)
. "$here/porthole-spec-lib.sh"
[ $# -ge 2 ] || { echo "usage: $me SLUG NAME [ARG...]" >&2; exit 2; }
slug=$1 name=$2; shift 2
spec=$(spec_find "$slug") || exit 2
NAME= CONTAINER= APP_USER= APP_HOME= EXTRA_ENV= CLI=
. "$spec"
case " $CLI " in *" $name "*) ;; *) echo "$me: $slug declares no CLI '$name'" >&2; exit 2 ;; esac
v=$(printf '%s' "$name" | tr - _)
eval "prog=\${CLI_$v:-} user=\${CLI_USER_$v:-}"
[ -n "$prog" ] || { echo "$me: $slug declares no CLI '$name'" >&2; exit 2; }
user=${user:-$APP_USER}

spec_docker_env
spec_running "$CONTAINER" || { echo "$NAME isn't running; open it first." >&2; exit 1; }

# docker exec OPTS CONTAINER PROG ARG..., built in front of the arguments (POSIX sh has no arrays).
n=$#
set -- "$@" -i
{ [ -t 0 ] && [ -t 1 ]; } && set -- "$@" -t
set -- "$@" -u "$user" -e "HOME=$APP_HOME" -e XDG_RUNTIME_DIR=/run/user/1000   # where the app's sockets are
for e in $EXTRA_ENV; do set -- "$@" -e "$e"; done
set -- "$@" "$CONTAINER" "$prog"
i=0; while [ "$i" -lt "$n" ]; do set -- "$@" "$1"; shift; i=$((i + 1)); done

err=$(mktemp "${TMPDIR:-/tmp}/porthole-cli.XXXXXX") || exit 1
trap 'rm -f "$err" "$err.rc"' EXIT
tries=0
while :; do
  # stdout straight through (fd 3); stderr through tee, kept to recognise a connection error.
  { { docker exec "$@"; echo $? > "$err.rc"; } 2>&1 1>&3 | tee "$err" >&2; } 3>&1
  rc=$(cat "$err.rc" 2>/dev/null || echo 1)
  [ "$rc" -ne 0 ] && [ "$tries" -eq 0 ] \
    && grep -qiE 'error during connect|cannot connect to the docker daemon|i/o timeout|connection refused' "$err" \
    || exit "$rc"
  tries=1
  unset DOCKER_HOST DOCKER_CONTEXT DOCKER_TLS_VERIFY DOCKER_CERT_PATH
  spec_docker_env
done
