#!/bin/sh
# ONE-TIME MIGRATION off the ModernMavericks identity (flag day 2026-09-22): this pkg's identifier
# was dev.modernmavericks.porthole. The payload paths did not move (Applications/Porthole.app,
# usr/local/bin/porthole), so the new receipt now owns them; without this the OLD receipt survives
# too, and pkgutil reports two packages owning one app forever. The old updater and its agent are
# retired by the shared updater/agent-load.in that renders this pkg's postinstall, as for every
# product.
#
# Viewers materialized before the flag day ("Linux <App>.app", bundle id
# dev.modernmavericks.porthole.<slug>) are left alone: each carries its own engine binary, which
# keys per-app behavior off the id's LAST component, so they keep working, and they pick up the new
# id when their preset pkg is next installed (its postinstall re-materializes them).
#
# Scoped to Installer's target volume ($3); best-effort, never fails the install.
# DELETABLE once no pre-flag-day install survives (see shipyard SKILL.md "Consolidation backlog").
[ -n "${3:-}" ] || { echo "porthole: preinstall got no target volume; migrating nothing" >&2; exit 0; }
pkgutil --volume "$3" --forget dev.modernmavericks.porthole >/dev/null 2>&1
exit 0
